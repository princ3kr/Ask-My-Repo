# ─────────────────────────────────────────────────────────────
# Ask My Repo — environment configuration
# Copy to `.env` and fill in real values:  cp .env.example .env
# `.env` is gitignored. Never commit real credentials.
# ─────────────────────────────────────────────────────────────


# ═══════════════════════════════════════════════════════════
# MODELS — override to change without touching code
# ═══════════════════════════════════════════════════════════

# Dense embedding model, run locally via fastembed/ONNX.
# Alternatives worth trying for code retrieval:
#   nomic-ai/CodeRankEmbed        (code-specific, strong)
#   BAAI/bge-code-v1              (code-specific, 8192 ctx)
#   sentence-transformers/all-MiniLM-L6-v2  (fast, weaker)
# NOTE: changing this requires re-indexing. Vector dimensions and the
# vector space differ, so an existing collection will not match.
EMBED_MODEL=jinaai/jina-embeddings-v2-base-code

# Sparse/lexical model for BM25-style matching alongside the dense vectors.
SPARSE_MODEL=Qdrant/bm25

# Primary chat/structured-output model.
LLM_MODEL=gpt-4o

# Fallback provider's model, used only when the primary fails with a
# quota/rate-limit/auth error. See llm_fallback.py for the trigger list.
LLM_FALLBACK_MODEL=llama-3.3-70b-versatile

# Model for the small decision hops (route, rewrite, Cypher, subtype).
# Left unset it uses LLM_MODEL, so behaviour is unchanged. Point it at a
# cheaper model to cut per-query latency and cost; the synthesizer keeps
# using LLM_MODEL.
# ROUTER_MODEL=gpt-4o-mini

# Embedding batch limits. Chunks are length-sorted before batching, and a
# batch is closed when EITHER limit is reached. The character limit is the
# one that matters for memory: a fixed count of 16 long chunks was measured
# OOM-killing the process on a 15GB machine. Lower EMBED_BATCH_CHARS if
# indexing still runs out of memory.
EMBED_BATCH_SIZE=16
EMBED_BATCH_CHARS=40000

# Optional cross-encoder reranker. Empty = keep re-sorting by Qdrant's own
# score (current behaviour). Set a fastembed reranker id to truly reorder.
# RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
# RERANK_TOP_N=20


# ═══════════════════════════════════════════════════════════
# LLM PROVIDERS
# ═══════════════════════════════════════════════════════════

# Required. Read implicitly by langchain_openai.ChatOpenAI.
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# Optional. Read implicitly by langchain_groq.ChatGroq.
# NOTE: the Groq client is constructed lazily, so leaving this blank
# is fine until you actually need the fallback.
GROQ_API_KEY=gsk_your-groq-api-key-here


# ═══════════════════════════════════════════════════════════
# NEO4J — dependency graph
# ═══════════════════════════════════════════════════════════

# Required. All three are needed; the app raises ValueError without them.
# Neo4j Aura Cloud users: use the neo4j+s:// URI from the "Connect" tab.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASS=your-neo4j-password-here

# Neo4j Aura Cloud also needs the CA cert, e.g.
# NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
# NEO4J_CA_CERT=/path/to/neo4j-ca-cert.crt


# ═══════════════════════════════════════════════════════════
# QDRANT — vector + sparse (BM25) search index
# ═══════════════════════════════════════════════════════════

# Qdrant Cloud URL, e.g. https://xyz-abc-123.us-east-1.aws.cloud.qdrant.io:6333
# NOTE: variable name is misspelled upstream (END_POINT, not ENDPOINT).
QDRANT_END_POINT=http://localhost:6333

# VectorStore raises ValueError if either this or the URL is missing —
# including for a local instance, which needs no real key.
QDRANT_API_KEY=your-qdrant-api-key-here


# ═══════════════════════════════════════════════════════════
# OPTIONAL TUNING
# ═══════════════════════════════════════════════════════════

# Delete a repo's Neo4j graph + Qdrant collection after this many hours
# without a chat request. Defaults to 3 if unset.
REPO_INACTIVITY_TIMEOUT_HOURS=3

# How often the background cleanup thread wakes up to check.
# Defaults to 5 (minutes) if unset.
CLEANUP_CHECK_INTERVAL_MINUTES=5

# Query-path cache limits (LRU size + TTL in seconds).
# Inspect live hit rates at GET /api/cache/stats.
CACHE_MAX_ENTRIES=500
CACHE_TTL_SECS=1800
GRAPH_CACHE_MAX_ENTRIES=200
GRAPH_CACHE_TTL_SECS=1800


# ═══════════════════════════════════════════════════════════
# MODEL CACHE — not configurable
# ═══════════════════════════════════════════════════════════
# vector_db.py hard-assigns these AFTER load_dotenv() runs, so
# anything set here is silently overwritten. Kept visible for
# reference only; do not edit.
#
#   HF_HOME=src/models
#   FASTEMBED_CACHE_PATH=src/models/fastembed
#
# To change the cache location, edit base_dir/model_cache_dir in
# src/backend/services/vector_db.py instead.

# ═══════════════════════════════════════════════════════════
# DSPY (optional — off unless ASK_DSPY=1)
# ═══════════════════════════════════════════════════════════
# Five programs replace the individual prompts in the query
# pipeline: route, rewrite, cypher, synthesize, verify. LangGraph
# still orchestrates; DSPy only replaces the prompts.
#
# Every program falls back to the original LangChain prompt on any
# failure, so turning this on cannot produce a 500.
#
# ASK_DSPY=1               serve answers from the DSPy programs
# ASK_DSPY=1               (unset = off; default behaviour is unchanged)
#
# DSPY_TIER                which model serves which program
#                          mixed  (default) route/rewrite/cypher/verify
#                                          on the cheap model, synthesize
#                                          on the strong model
#                          cheap              everything on the cheap model
#                          strong             everything on the strong model
#
# DSPY_CHEAP               default openai/gpt-4o-mini
# DSPY_STRONG              default openai/gpt-4o
#
# ASK_DSPY_SHADOW=1        run DSPy on every request and DISCARD the result,
#                          recording agreement against the legacy path in
#                          DspyRuntime.stats. Costs an extra model call per
#                          request, so it is off by default. Use it to gather
#                          evidence before switching a program over.
#
# ASK_NO_GATES=1           always run the query rewriter, even for questions
#                          that need no rewriting. Measures what the gate saves.
#
# ASK_NO_SPECULATE=1       never overlap vector retrieval with Cypher
#                          generation. Use if a deployment sees cross-request
#                          interference (neither DB client is documented as
#                          thread-safe).
#
# DSPY_OPT_TIER            model assignment used while *optimising*
#                          (default cheap). The saved artefact is prompts and
#                          demos, which are portable across models.
